            "rationale": "Creates concurrent reads that can violate the invariant."
          },
          {
            "type": "duplicate_request",
            "score": 0.6,
            "rationale": "May cause double commit if the operation is not idempotent, but less likely to expose a race."
          },
          {
            "type": "delay_response",
            "score": 0.4,
            "rationale": "Can widen timing windows but does not guarantee overlapping reads from distinct actors."
          }
        ],
        "branch_point": "buyer A reads stock=1",
